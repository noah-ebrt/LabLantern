# Netzseitiger Teil: hält die Verbindung zum Master, ohne root, ohne Capabilities, ohne offenen Port.
# Daten erhebt er nicht selbst, sondern legt einen Auftrag für vulnwatch-collect.service ab.
[Unit]
Description=vulnwatch agent (talks to the master, unprivileged)
After=network-online.target
Wants=network-online.target

[Service]
User=vulnwatch
Group=vulnwatch
ExecStart=/usr/bin/vulnwatch-agent daemon
Restart=always
RestartSec=30
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/vulnwatch
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
